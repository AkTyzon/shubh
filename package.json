{
  "name": "shubh",
  "version": "1.0.0",
  "private": true,
  "description": "Plan an Indian celebration on a budget that actually adds up and a timeline that is actually possible",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run verify:csp && npm run verify:no-key && npm run build",
    "verify:no-key": "tsx scripts/verify-without-key.ts",
    "verify:csp": "tsx scripts/check-csp.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  }
}
